# MongoDB Atlas (database name in URL path must be orb_music)
DATABASE_URL="mongodb+srv://USERNAME:PASSWORD@CLUSTER_HOST/orb_music?retryWrites=true&w=majority"

# Supabase Storage (optional for local development): create a PUBLIC bucket named tracks
# (or set another bucket below). Without these values, a local server stores uploads in
# public/uploads; Vercel requires Supabase because its filesystem is read-only/ephemeral.
# Keep the service role key secret; add these values in Vercel Environment Variables too.
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"
SUPABASE_STORAGE_BUCKET="tracks"
